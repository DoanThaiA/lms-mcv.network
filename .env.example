# Copy thành .env (không commit). Sinh giá trị ngẫu nhiên:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# Mật khẩu user pm_user — CÙNG giá trị PM_DB_PASSWORD trong project_manager/.env (dùng chung database)
PM_DB_PASSWORD=
# Khoá ký JWT của LMS — khác SECRET_KEY của project_manager, dài >= 48 ký tự
LMS_SECRET_KEY=

# --- Kết nối tới PostgreSQL của ai_carbon_analyst ---
PM_DB_HOST=carbon_analyst_db
PM_DB_NETWORK=ai_carbon_analyst_default
PG_CONTAINER=carbon_analyst_db

# --- Cổng ---
# Server có nginx đứng trước: 127.0.0.1. Máy dev / LAN: 0.0.0.0
LMS_BIND_ADDR=0.0.0.0
LMS_API_PORT=8001
LMS_WEB_PORT=3001
LMS_CORS_ORIGINS=["http://localhost:3001"]

# --- Cloudflare R2: lưu tài liệu / video bài học ---
R2_ACCOUNT_ID=
R2_BUCKET=lms
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_KEY_PREFIX=lms/
FILE_MAX_MB=2048
FILE_OFFICE_PREVIEW=true
