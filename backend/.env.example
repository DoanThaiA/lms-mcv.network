# Dùng chung database project_manager (PostgreSQL của ai_carbon_analyst); mật khẩu = PM_DB_PASSWORD trong ../.env
DATABASE_URL=postgresql+asyncpg://pm_user:<PM_DB_PASSWORD>@localhost:5433/project_manager
# Khoá ký JWT riêng của LMS, khác SECRET_KEY của project_manager: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
DEBUG=false
CORS_ORIGINS=["http://localhost:3001","http://localhost:5173"]
# Sai mật khẩu quá LOGIN_MAX_FAILURES lần trong LOGIN_LOCK_MINUTES phút thì tạm khoá đăng nhập LMS
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Cloudflare R2: lưu tài liệu / video bài học (bucket private, xem README mục "Lưu file trên Cloudflare R2") ---
R2_ACCOUNT_ID=
R2_BUCKET=lms
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Chỉ đặt khi bucket ở vùng EU: <account_id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
# Tiền tố object key; dùng chung bucket với project_manager vẫn không lẫn file
R2_KEY_PREFIX=lms/
FILE_MAX_MB=2048
# Xem trước Word / Excel / PowerPoint qua Microsoft Office Online; false = chỉ tải về
FILE_OFFICE_PREVIEW=true
